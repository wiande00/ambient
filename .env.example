# Development fallbacks only. The app itself is configured on its Settings screen, which
# writes ~/.ambient/config.json; anything set there wins over these.

# console.anthropic.com → API Keys. Server-only; never expose as NEXT_PUBLIC_.
# Optional: without it the dashboard still paints every measured figure from local disk, and
# only the interpreted text (the sentence and project per chunk) is absent.
ANTHROPIC_API_KEY=

# The idle rule: seconds without input after which the stretch since the last input counts
# as idle. Applied when the log is read, so changing it needs no recollecting. Default 300.
AMBIENT_AFK_SECONDS=300

# The break rule: minutes an untouched window has to sit before the stretch ends and a break
# is drawn in its own right, rather than counting as idle inside the chunk. A hole in the day
# — locked, asleep, collector down — always ends a stretch at twenty minutes. Default 20.
AMBIENT_BREAK_MINUTES=20
